# Normalise line endings so a Windows/macOS mix does not produce whole-file diffs.
* text=auto
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.py text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Preset demo papers must stay byte-identical.
*.pdf binary
