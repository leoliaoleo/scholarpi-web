{
  "name": "scholarpi-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ScholarPi Web - browser-side research literature agent workbench (Flask + Preact + pi-agent-core)",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "dev:front": "node build.mjs --dev --watch",
    "dev:back": "python backend/app.py"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "d3-array": "^3.2.5",
    "d3-drag": "^3.0.1",
    "d3-force": "^3.0.1",
    "d3-scale": "^4.0.3",
    "d3-selection": "^3.0.1",
    "d3-transition": "^3.0.2",
    "d3-zoom": "^3.0.1",
    "katex": "^0.16.22",
    "markdown-it": "^15.0.3",
    "mermaid": "^11.12.0",
    "pdfjs-dist": "^5.4.314",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "esbuild": "^0.25.11",
    "typescript": "^5.9.3"
  }
}
